# Server-side only. Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
# Never prefix these with VITE_ — that would ship them to the browser.

# Set ONE of these. Without any, the app runs in clearly labelled keyword-fallback mode.
# Groq is free and fast (console.groq.com); Gemini is free (aistudio.google.com); Anthropic is paid.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. If more than one key is set, picks which provider runs: "anthropic" | "gemini" | "groq".
# With only one key set, that provider is used automatically and this can be left blank.
AI_PROVIDER=

# Optional. Model used for interpretation. Defaults per provider:
#   anthropic → claude-haiku-5-5
#   gemini    → gemini-3.8-flash
#   groq      → openai/gpt-oss-20b
AI_MODEL=

# Optional. Milliseconds before giving up on the model and falling back.
AI_TIMEOUT_MS=20000

# Gemini only. How much the model "thinks" before answering: minimal | low | medium | high.
# Gemini 3.x Flash defaults to high, which is slow; this app uses "low" for fast structured output.
# Lower = faster. Only change this if a model needs more reasoning.
GEMINI_THINKING_LEVEL=low

# OpenAI-compatible providers (groq) only. Overrides the chat-completions URL, e.g. to use OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_BASE_URL=
