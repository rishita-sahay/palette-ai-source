# Server-side only. Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
# Never prefix these with VITE_ — that would ship them to the browser.

# Set ONE of these (or both). Without either, the app runs in clearly labelled keyword-fallback mode.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. If both keys above are set, picks which provider runs: "anthropic" or "gemini".
# With only one key set, that provider is used automatically and this can be left blank.
AI_PROVIDER=

# Optional. Model used for interpretation. Defaults to claude-haiku-5-5 (Anthropic) or
# gemini-2.0-flash (Gemini) depending on which provider is active.
AI_MODEL=

# Optional. Milliseconds before giving up on the model and falling back.
AI_TIMEOUT_MS=20000
